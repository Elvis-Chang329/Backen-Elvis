# ==========================================
# CONFIGURACIÓN DEL SERVIDOR Y CORS
# ==========================================
PORT=3000
NODE_ENV=development

# Configuración de CORS: Permite '*' para todas las fuentes o lista separada por comas
CORS_ORIGIN=*

# URL Pública de este Backend accesible desde AWS Lambda / Internet (NO localhost desde la nube)
# Ejemplo con ngrok: https://xxxx-xx-xx.ngrok-free.app
# Ejemplo en AWS EC2: http://ec2-xx-xx-xx-xx.compute-1.amazonaws.com:3000
BACKEND_PUBLIC_URL=https://tu-backend-publico.com

# ==========================================
# CONEXIÓN A POSTGRESQL
# ==========================================
# Opción 1: Variables individuales (Docker local / RDS / PostgreSQL local)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=app_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL=false

# Opción 2: Cadena de conexión completa (URI) si usas AWS RDS, Supabase, Neon o Render
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app_db?sslmode=disable

# ==========================================
# AWS SDK CREDENTIALS (Rekognition & S3)
# ==========================================
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=tu_aws_access_key_id
AWS_SECRET_ACCESS_KEY=tu_aws_secret_access_key

# Rekognition & S3 identifiers
AWS_REKOGNITION_COLLECTION_ID=faces-collection
AWS_S3_BUCKET=tu-bucket-de-rostros
